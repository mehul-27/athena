# ============================================================
# Athena — environment configuration
# ============================================================
# Copy this file to `.env` and fill in your values:
#
#     copy .env.example .env
#
# REQUIRED: at least ONE LLM provider key. NVIDIA_API_KEY is the primary
#           provider; GROQ_API_KEY and OPENROUTER_API_KEY are optional
#           fallbacks. Everything else in this file has a working default.
#
# Do NOT commit real secrets.
# ============================================================

# ============================================================
# Application
# ============================================================
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# ============================================================
# LLM PROVIDERS — BOOTSTRAP ONLY
# ============================================================
# Providers and models are configured in the Athena **Settings** modal
# (Settings → Add Models). That writes data/providers.json, which is the
# authoritative configuration — you never need to edit this file to add a
# provider, change a model or endpoint, rotate a key, or reorder the fallback
# chain. Any OpenAI-compatible endpoint can be added there, including providers
# not listed below.
#
# This block is only read ONCE, on a fresh install, to seed the store from an
# existing environment. After that the store wins, and a provider removed in
# Settings does not come back.
#
#   #  provider     default model                          endpoint
#   1  NVIDIA NIM   nvidia/nemotron-3.5-lightning-30b-a3b  https://integrate.api.nvidia.com/v1
#   2  Groq         qwen/qwen3.8-27b                       https://api.groq.com/openai/v1
#   3  OpenRouter   nvidia/nemotron-3.5-lightning:free     https://openrouter.ai/api/v1
#   4  Google       gemini-3.6-flash                        https://generativelanguage.googleapis.com/v1beta/openai
ATHENA_LLM_PROVIDERS=nvidia,groq,openrouter,google

# --- 1. NVIDIA NIM ------------------------------------------
# Get a key: https://build.nvidia.com   (keys look like "nvapi-...")
NVIDIA_API_KEY=
ATHENA_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- 2. Groq ------------------------------------------------
# Get a key: https://console.groq.com/keys   (keys look like "gsk_...")
# Optional: leave blank to skip Groq and fall straight through to OpenRouter.
GROQ_API_KEY=
ATHENA_GROQ_MODEL=qwen/qwen3.8-27b

# --- 3. OpenRouter ------------------------------------------
# Get a key: https://openrouter.ai/keys   (keys look like "sk-or-...")
# Optional, but recommended as the last line of defence.
OPENROUTER_API_KEY=
ATHENA_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- 4. Google (Gemini) -------------------------------------
# Get a key: https://aistudio.google.com/app/apikey   (free tier available)
# GEMINI_API_KEY is accepted as an alias for GOOGLE_API_KEY.
# Google retires pinned models for new users; if a model 404s, pick a current
# one in Settings (Refresh models lists what your key can actually use).
GOOGLE_API_KEY=
ATHENA_GOOGLE_MODEL=gemini-3.6-flash

# Shared generation settings, applied to whichever provider answers.
# LLM_TIMEOUT must exceed the slowest provider's response time for that provider
# to ever answer — set it to ~200 if you want NVIDIA Nemotron to finish rather
# than time out and hand over.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# --- Legacy names (optional) --------------------------------
# Pre-provider-split installs may keep using these; the provider-specific
# variables above always take precedence when both are set.
# LLM_API_KEY=          # used as the OpenRouter key when OPENROUTER_API_KEY is blank
# ATHENA_LLM_MODEL=     # used as the OpenRouter model when ATHENA_OPENROUTER_MODEL is blank

# ============================================================
# ChromaDB (vector store)
# ============================================================
# embedded  -> local persistent store under data/chroma (no service needed) [default]
# http      -> talk to a standalone ChromaDB server (host/port below)
CHROMA_MODE=embedded
# CHROMA_PATH=            # defaults to ./data/chroma (embedded mode)
# CHROMA_HOST=localhost
# CHROMA_PORT=8100

RAG_COLLECTION=athena_documents
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
# Minimum hybrid relevance score for a chunk to be used in RAG Chat.
# Below this, RAG Chat refuses to answer instead of guessing. Tunable.
RAG_RELEVANCE_THRESHOLD=0.25

# ============================================================
# Embeddings
# ============================================================
# fastembed -> local ONNX model, no service, works offline after first download [default]
# http      -> OpenAI-compatible /v1/embeddings endpoint
# hashing   -> deterministic offline bag-of-words embedding (tests / no-download mode)
EMBEDDING_PROVIDER=fastembed
# EMBEDDING_URL=http://localhost:11434/v1/embeddings
# EMBEDDING_MODEL=all-minilm:l6-v2
# EMBEDDING_API_KEY=
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=    # defaults to ./data/fastembed_cache
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CHARS=900

# ============================================================
# Storage
# ============================================================
# DATA_DIR=                # defaults to ./data
# DOCUMENTS_DIR=           # defaults to ./documents (uploaded PDFs)
UPLOAD_MAX_BYTES=26214400

# ============================================================
# Search (separate capability — never available to RAG Chat)
# ============================================================
# duckduckgo (no key) | searxng | brave | tavily | serper | google_pse | disabled
SEARCH_PROVIDER=duckduckgo
# SEARXNG_INSTANCE=http://localhost:8080
SEARCH_RESULT_COUNT=5
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
# GOOGLE_PSE_KEY=
# GOOGLE_PSE_CX=

# Page fetching for Search
WEB_FETCH_TIMEOUT=10
WEB_FETCH_MAX_BYTES=2000000
SEARCH_FETCH_PAGES=3
SEARCH_ANSWER=true

# ============================================================
# Deep Research
# ============================================================
# Rounds are adaptive: the engine runs at least RESEARCH_MIN_ROUNDS, then asks
# the model whether the evidence is sufficient and stops as soon as it is, up
# to RESEARCH_MAX_ROUNDS. Each run also has a soft time budget and hard timeout.
RESEARCH_MAX_ROUNDS=20
RESEARCH_MAX_TIME=300
# Small floor — a high value forced ~18 rounds of LLM work before the stop
# check could ever fire, which is what made free-tier research crawl.
RESEARCH_MIN_ROUNDS=2
RESEARCH_MAX_EMPTY_ROUNDS=2
# Stop early after N consecutive rounds that add no new findings.
RESEARCH_MAX_STAGNANT_ROUNDS=2
RESEARCH_MAX_URLS_PER_ROUND=3
RESEARCH_MAX_CONTENT_CHARS=15000
RESEARCH_MAX_REPORT_TOKENS=16384
RESEARCH_EXTRACTION_TIMEOUT_SECONDS=90
RESEARCH_PLANNING_TIMEOUT_SECONDS=90
RESEARCH_QUERY_TIMEOUT_SECONDS=120
RESEARCH_EXTRACTION_CONCURRENCY=3
# Extract several pages per LLM call instead of one call per page.
RESEARCH_BATCH_EXTRACTION=true
RESEARCH_EXTRACTION_BATCH_SIZE=3
RESEARCH_SYNTHESIS_WINDOW=10
RESEARCH_RUN_TIMEOUT_SECONDS=1800
# Blank uses SEARCH_PROVIDER above.
# RESEARCH_SEARCH_PROVIDER=searxng
# RESEARCH_DATA_DIR=        # defaults to ./data/research

# Research model roles (also editable in the Settings UI):
#   FAST   -> planning, query generation, page extraction, stop decisions
#   STRONG -> round synthesis and the final report
# Blank = use whatever model the active provider is configured with.
# RESEARCH_FAST_MODEL=
# RESEARCH_STRONG_MODEL=

# ============================================================
# Tests
# ============================================================
# Set to 1 to enable the opt-in real-LLM end-to-end suite (needs a provider key).
ATHENA_E2E=0
